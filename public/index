# ============================================================
# CLOUDFLARED UNINSTALL
# ============================================================

uninstall_cloudflared() {

    clear_screen

    echo -e "${CYAN}"
    echo "╭──────────────────────────────────────────────────────────────────────────────╮"
    echo "│                         🗑 UNINSTALL CLOUDFLARED                            │"
    echo "╰──────────────────────────────────────────────────────────────────────────────╯"
    echo -e "${RESET}"

    echo

    if ! command -v cloudflared >/dev/null 2>&1 &&
       [[ ! -f /usr/local/bin/cloudflared ]]; then
        show_info "Cloudflared is not installed."
        pause_short
        return
    fi

    if ! confirm_action "This will remove Cloudflared from this server."; then
        pause_short
        return
    fi

    if command_exists systemctl; then
        systemctl stop cloudflared 2>/dev/null || true
        systemctl disable cloudflared 2>/dev/null || true
    fi

    rm -f /usr/local/bin/cloudflared

    if [[ -e /usr/local/bin/cloudflared ]]; then
        show_error "Cloudflared could not be removed."
    else
        show_success "Cloudflared removed successfully."
    fi

    pause_short
}

# ============================================================
# TAILSCALE UNINSTALL
# ============================================================

uninstall_tailscale() {

    clear_screen

    echo -e "${CYAN}"
    echo "╭──────────────────────────────────────────────────────────────────────────────╮"
    echo "│                          🗑 UNINSTALL TAILSCALE                             │"
    echo "╰──────────────────────────────────────────────────────────────────────────────╯"
    echo -e "${RESET}"

    echo

    if ! command_exists tailscale; then
        show_info "Tailscale is not installed."
        pause_short
        return
    fi

    if ! confirm_action "This will remove Tailscale from this server."; then
        pause_short
        return
    fi

    if command_exists systemctl; then
        systemctl disable --now tailscaled 2>/dev/null || true
    fi

    local removed=0

    if command_exists apt-get; then

        export DEBIAN_FRONTEND=noninteractive

        if apt-get remove --purge -y tailscale; then
            removed=1
        fi

        apt-get autoremove -y >/dev/null 2>&1 || true

    elif command_exists dnf; then

        if dnf remove -y tailscale; then
            removed=1
        fi

    elif command_exists yum; then

        if yum remove -y tailscale; then
            removed=1
        fi

    fi

    if (( removed == 1 )) && ! command_exists tailscale; then
        show_success "Tailscale removed successfully."
    elif ! command_exists tailscale; then
        show_success "Tailscale binary is no longer available."
    else
        show_error "Tailscale could not be fully removed."
    fi

    pause_short
}

