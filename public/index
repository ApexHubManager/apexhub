# ============================================================
# SERVER INFORMATION
# ============================================================

server_information() {

    clear_screen

    local hostname_value
    local os_name
    local kernel
    local cpu
    local cores
    local ram
    local disk
    local uptime_value
    local ipv4
    local private_ipv4
    local ipv6
    local ip_type

    hostname_value="$(hostname 2>/dev/null || echo "Unknown")"

    os_name="$(
        . /etc/os-release 2>/dev/null
        echo "${PRETTY_NAME:-Unknown}"
    )"

    kernel="$(uname -r 2>/dev/null || echo "Unknown")"

    cpu="$(
        lscpu 2>/dev/null |
        awk -F: '/Model name/ {
            gsub(/^[ \t]+/, "", $2);
            print $2;
            exit
        }'
    )"

    [[ -z "$cpu" ]] && cpu="Unknown"

    cores="$(
        nproc 2>/dev/null || echo "Unknown"
    )"

    ram="$(
        free -h 2>/dev/null |
        awk '/^Mem:/ {print $3 " / " $2}'
    )"

    [[ -z "$ram" ]] && ram="Unknown"

    disk="$(
        df -h / 2>/dev/null |
        awk 'NR==2 {print $3 " / " $2 " (" $5 " used)"}'
    )"

    [[ -z "$disk" ]] && disk="Unknown"

    uptime_value="$(uptime -p 2>/dev/null || echo "Unknown")"

    ipv4="$(
        curl -4 -fsSL --max-time 5 https://api.ipify.org 2>/dev/null || true
    )"

    [[ -z "$ipv4" ]] && ipv4="No IPv4 address"

    private_ipv4="$(
        ip -4 addr show scope global 2>/dev/null |
        awk '
        /inet / {
            split($2,a,"/");
            if (a[1] !~ /^127\./) {
                print a[1];
                exit
            }
        }'
    )"

