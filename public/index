# ============================================================
# DOWNLOAD SPEED TEST
# ============================================================

download_speed_test() {

    clear_screen

    echo -e "${CYAN}"
    echo "╭──────────────────────────────────────────────────────────────────────────────╮"
    echo "│                         📥 DOWNLOAD SPEED TEST                              │"
    echo "╰──────────────────────────────────────────────────────────────────────────────╯"
    echo -e "${RESET}"

    echo

    if ! command_exists curl; then
        show_error "curl is required."
        pause_short
        return
    fi

    local url="https://speed.cloudflare.com/__down?bytes=10000000"
    local tmp
    local start
    local end
    local elapsed
    local bytes
    local mbps

    tmp="$(mktemp /tmp/apex-speed.XXXXXX)"

    echo -e "  ${CYAN}→${RESET} Downloading 10 MB test file..."
    echo

    start="$(date +%s.%N)"

    if ! curl -L -f -sS \
        --connect-timeout 10 \
        --max-time 60 \
        "$url" \
        -o "$tmp"; then

        rm -f "$tmp"
        show_error "Speed test failed."
        pause_short
        return
    fi

    end="$(date +%s.%N)"

    bytes="$(stat -c%s "$tmp" 2>/dev/null || echo 0)"

    rm -f "$tmp"

    if [[ "$bytes" -le 0 ]]; then
        show_error "No data was downloaded."
        pause_short
        return
    fi

    elapsed="$(awk -v s="$start" -v e="$end" 'BEGIN {print e-s}')"

    if awk -v t="$elapsed" 'BEGIN {exit !(t > 0)}'; then
        mbps="$(awk -v b="$bytes" -v t="$elapsed" 'BEGIN {printf "%.2f", (b*8/t)/1000000}')"
    else
        mbps="0.00"
    fi

    echo -e "  ${GREEN}[✓] Test completed${RESET}"
    echo
    echo -e "  Downloaded : ${WHITE}$((bytes / 1024 / 1024)) MB${RESET}"
    echo -e "  Time       : ${WHITE}${elapsed}s${RESET}"
    echo -e "  Speed      : ${GREEN}${mbps} Mbps${RESET}"

    pause_short
}

