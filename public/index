# ============================================================
# BLUEPRINT SELECTOR
# ============================================================

blueprint_select_menu() {

    local action="$1"
    local selected=()

    while true; do

        clear_screen

        echo -e "${CYAN}"
        echo "╭──────────────────────────────────────────────────────────────────────────────╮"
        echo "│                         📦 BLUEPRINT SELECTOR                               │"
        echo "╰──────────────────────────────────────────────────────────────────────────────╯"
        echo -e "${RESET}"

        echo

        local left=""
        local right=""
        local i
        local num
        local name
        local marker

        for ((i=0; i<${#BLUEPRINT_NAMES[@]}; i++)); do

            num=$((i + 1))
            name="${BLUEPRINT_NAMES[$i]}"

            marker="○"

            if contains_selection "$num" "${selected[@]}"; then
                marker="${GREEN}●${RESET}"
            fi

            name="${name%.blueprint}"

            if (( i % 2 == 0 )); then
                printf "  ${WHITE}%02d${RESET}  %-28s %b" \
                    "$num" "$name" "$marker"
            else
                printf "       ${GRAY}│${RESET} ${WHITE}%02d${RESET}  %-28s %b\n" \
                    "$num" "$name" "$marker"
            fi

        done

        if (( ${#BLUEPRINT_NAMES[@]} % 2 != 0 )); then
            echo
        fi

        echo
        echo -e "  ${GRAY}────────────────────────────────────────────────────────────────────────────${RESET}"
        echo
        echo -e "  SELECTED : ${GREEN}${#selected[@]}${RESET}"
        echo

        if [[ "$action" == "install" ]]; then
            echo -e "  ${CYAN}[i]${RESET} Install    ${CYAN}[a]${RESET} All    ${CYAN}[c]${RESET} Clear    ${CYAN}[0]${RESET} Back"
        else
            echo -e "  ${CYAN}[r]${RESET} Remove     ${CYAN}[a]${RESET} All    ${CYAN}[c]${RESET} Clear    ${CYAN}[0]${RESET} Back"
        fi

        echo
        read -r -p "  ➜ Select ID(s) or Action: " input

        case "$input" in

            0)
                return
                ;;

            a|A)
                selected=()

                for ((i=1; i<=${#BLUEPRINT_NAMES[@]}; i++)); do
                    selected+=("$i")
                done
                ;;

            c|C)
                selected=()
                ;;

            i|I)
                if [[ "$action" == "install" ]]; then
                    if (( ${#selected[@]} == 0 )); then
                        show_error "No blueprints selected."
                        sleep 1
                    else
                        install_selected_blueprints "${selected[@]}"
                        return
                    fi
                else
                    show_error "Use [r] to remove blueprints."
                    sleep 1
                fi
                ;;

            r|R)
                if [[ "$action" == "remove" ]]; then
                    if (( ${#selected[@]} == 0 )); then
                        show_error "No blueprints selected."
                        sleep 1
                    else
                        remove_selected_blueprints "${selected[@]}"
                        return
                    fi
                else
                    show_error "Use [i] to install blueprints."
                    sleep 1
                fi
                ;;

            *)
                parse_blueprint_selection "$input" selected
                ;;
        esac

    done
}

# ============================================================
# BLUEPRINT SELECTION HELPERS
# ============================================================

contains_selection() {

    local value="$1"
    shift

    local item

    for item in "$@"; do
        [[ "$item" == "$value" ]] && return 0
    done

    return 1
}

parse_blueprint_selection() {

    local input="$1"
    local array_name="$2"

    local -n result="$array_name"

    local cleaned
    local token
    local num
    local max

    cleaned="${input//,/ }"

    read -ra tokens <<< "$cleaned"

    max="${#BLUEPRINT_NAMES[@]}"

    for token in "${tokens[@]}"; do

        if [[ "$token" =~ ^[0-9]+$ ]]; then

            num=$((10#$token))

            if (( num >= 1 && num <= max )); then

                if ! contains_selection "$num" "${result[@]}"; then
                    result+=("$num")
                fi

            else
                echo -e "  ${RED}[✗] Invalid Blueprint ID: $num${RESET}"
                sleep 1
            fi

        else
            echo -e "  ${RED}[✗] Invalid selection: $token${RESET}"
            sleep 1
        fi

    done
}

# ============================================================
# BLUEPRINT INSTALL
# ============================================================

install_selected_blueprints() {

    local selected=("$@")
    local temp_dir
    local index
    local file
    local name
    local failed=0
    local installed=0

    if ! command_exists curl; then
        show_error "curl is required."
        pause_short
        return
    fi

    if ! command_exists blueprint; then
        show_error "Blueprint CLI was not found."
        echo
        echo -e "  ${GRAY}Install the Blueprint CLI first, then retry.${RESET}"
        pause_short
        return
    fi

    temp_dir="$(mktemp -d /tmp/apex-blueprints.XXXXXX)"

    if [[ ! -d "$temp_dir" ]]; then
        show_error "Could not create temporary directory."
        pause_short
        return
    fi

    echo

    for index in "${selected[@]}"; do

        file="${BLUEPRINT_NAMES[$((index - 1))]}"
        name="${file%.blueprint}"

        echo -e "  ${CYAN}→${RESET} Downloading ${WHITE}${file}${RESET}..."

        if ! curl -fsSL \
            --retry 2 \
            --connect-timeout 10 \
            --max-time 120 \
            "${BLUEPRINT_URL}/${file}" \
            -o "${temp_dir}/${file}"; then

            echo -e "    ${RED}[✗] Download failed${RESET}"
            failed=$((failed + 1))
            continue
        fi

        if [[ ! -s "${temp_dir}/${file}" ]]; then
            echo -e "    ${RED}[✗] Downloaded file is empty${RESET}"
            failed=$((failed + 1))
            continue
        fi

        echo -e "  ${CYAN}→${RESET} Installing ${WHITE}${name}${RESET}..."

        if blueprint -i "${temp_dir}/${file}"; then
            echo -e "    ${GREEN}[✓] Installed${RESET}"
            installed=$((installed + 1))
        else
            echo -e "    ${RED}[✗] Installation failed${RESET}"
            failed=$((failed + 1))
        fi

    done

    rm -rf "$temp_dir"

    echo
    echo -e "  ${GRAY}────────────────────────────────────────────────────────────────────────────${RESET}"

    if (( failed == 0 )); then
        show_success "${installed} Blueprint(s) installed successfully."
    else
        show_error "${failed} Blueprint(s) failed."
        echo -e "  ${GRAY}${installed} succeeded.${RESET}"
    fi

    pause_short
}

# ============================================================
# BLUEPRINT REMOVE
# ============================================================

remove_selected_blueprints() {

    local selected=("$@")
    local index
    local file
    local name
    local failed=0
    local removed=0

    if ! command_exists blueprint; then
        show_error "Blueprint CLI was not found."
        pause_short
        return
    fi

    if ! confirm_action "This will remove ${#selected[@]} Blueprint(s)."; then
        pause_short
        return
    fi

    echo

    for index in "${selected[@]}"; do

        file="${BLUEPRINT_NAMES[$((index - 1))]}"
        name="${file%.blueprint}"

        echo -e "  ${CYAN}→${RESET} Removing ${WHITE}${name}${RESET}..."

        if blueprint -r "$name"; then
            echo -e "    ${GREEN}[✓] Removed${RESET}"
            removed=$((removed + 1))
        else
            echo -e "    ${RED}[✗] Removal failed${RESET}"
            failed=$((failed + 1))
        fi

    done

    echo
    echo -e "  ${GRAY}────────────────────────────────────────────────────────────────────────────${RESET}"

    if (( failed == 0 )); then
        show_success "${removed} Blueprint(s) removed successfully."
    else
        show_error "${failed} Blueprint(s) failed to remove."
        echo -e "  ${GRAY}${removed} succeeded.${RESET}"
    fi

    pause_short
}

