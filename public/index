# ============================================================
# CLOUDFLARED INSTALL
# ============================================================

install_cloudflared() {

    clear_screen

    echo -e "${CYAN}"
    echo "╭──────────────────────────────────────────────────────────────────────────────╮"
    echo "│                         ☁ INSTALL CLOUDFLARED                              │"
    echo "╰──────────────────────────────────────────────────────────────────────────────╯"
    echo -e "${RESET}"

    echo

    if command -v cloudflared >/dev/null 2>&1; then
        show_info "Cloudflared is already installed."
        echo
        cloudflared --version 2>/dev/null || true
        pause_short
        return
    fi

    if ! command_exists curl; then
        show_error "curl is required."
        pause_short
        return
    fi

    local arch
    local download_arch
    local url="/usr/local/bin/cloudflared"
    local tmp="/tmp/cloudflared-apex"

    arch="$(uname -m)"

    case "$arch" in
        x86_64|amd64)
            download_arch="amd64"
            ;;
        aarch64|arm64)
            download_arch="arm64"
            ;;
        armv7l|armv7)
            download_arch="arm"
            ;;
        *)
            show_error "Unsupported architecture: $arch"
            pause_short
            return
            ;;
    esac

    echo -e "  Architecture : ${WHITE}${arch}${RESET}"
    echo -e "  Target       : ${WHITE}${url}${RESET}"
    echo

    echo -e "  ${CYAN}→${RESET} Downloading Cloudflared..."

    if ! curl -fL \
        --retry 2 \
        --connect-timeout 10 \
        --max-time 120 \
        "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${download_arch}" \
        -o "$tmp"; then

        rm -f "$tmp"
        show_error "Cloudflared download failed."
        pause_short
        return
    fi

    if [[ ! -s "$tmp" ]]; then
        rm -f "$tmp"
        show_error "Downloaded file is empty."
        pause_short
        return
    fi

    chmod +x "$tmp"

    if ! mv "$tmp" "$url"; then
        rm -f "$tmp"
        show_error "Could not install Cloudflared to /usr/local/bin."
        pause_short
        return
    fi

    if ! "$url" --version >/dev/null 2>&1; then
        rm -f "$url"
        show_error "Cloudflared installation verification failed."
        pause_short
        return
    fi

    show_success "Cloudflared installed successfully."

    echo
    "$url" --version 2>/dev/null || true

    pause_short
}

