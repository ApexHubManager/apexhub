panel_available() {
    [[ -d "$PTERODACTYL_DIR" && -f "$PTERODACTYL_DIR/artisan" ]] || return 1
    command_exists php || return 1
    return 0
}

create_pterodactyl_user() {
    local type="$1"
    show_page_header "👤  CREATE USER" "Create a new Pterodactyl panel account"
    echo
    if ! panel_available; then
        show_error "Pterodactyl Panel was not found."
        echo
        echo -e "  ${GRAY}Expected:${RESET} ${PTERODACTYL_DIR}/artisan"
        pause_short
        return
    fi
    if [[ "$type" == "admin" ]]; then echo -e "  ${YELLOW}Admin account creation${RESET}"
    else echo -e "  ${YELLOW}Normal account creation${RESET}"; fi
    echo
    echo -e "  ${GRAY}The official Pterodactyl user wizard will open below.${RESET}"
    echo -e "  ${GRAY}Follow its prompts carefully.${RESET}"
    echo
    cd "$PTERODACTYL_DIR" || { show_error "Could not access Pterodactyl directory."; pause_short; return; }
    if php artisan p:user:make; then show_success "User creation command completed."
    else show_error "User creation failed."; fi
    pause_short
}

list_pterodactyl_users() {
    show_page_header "👤  PTERODACTYL USERS" "List panel users"
    echo
    if ! panel_available; then show_error "Pterodactyl Panel was not found."; pause_short; return; fi
    cd "$PTERODACTYL_DIR" || { show_error "Could not access Pterodactyl directory."; pause_short; return; }
    echo -e "  ${WHITE}ID     USERNAME                  EMAIL${RESET}"
    echo -e "  ${GRAY}────────────────────────────────────────────────────────────────────────────${RESET}"
    if ! php artisan tinker --execute='
$users = App\Models\User::orderBy("id")->get();
foreach ($users as $user) {
    printf("%-6s %-25s %s\n", $user->id, $user->username, $user->email);
}
'; then show_error "Could not retrieve users."; fi
    pause_short
}

delete_pterodactyl_user() {
    local user_id confirm
    show_page_header "🗑  DELETE USER" "Remove a Pterodactyl panel account"
    echo
    if ! panel_available; then show_error "Pterodactyl Panel was not found."; pause_short; return; fi
    read -r -p "  ${CYAN}Enter User ID:${RESET} " user_id
    if [[ ! "$user_id" =~ ^[0-9]+$ ]]; then show_error "Invalid User ID."; pause_short; return; fi
    echo
    read -r -p "  ${RED}Delete user ID ${user_id}? [y/N]: ${RESET}" confirm
    case "$confirm" in y|Y|yes|YES) ;; *) echo -e "  ${GRAY}Cancelled.${RESET}"; pause_short; return ;; esac
    cd "$PTERODACTYL_DIR" || { show_error "Could not access Pterodactyl directory."; pause_short; return; }
    if php artisan tinker --execute="
\$user = App\Models\User::find(${user_id});
if (!\$user) {
    fwrite(STDERR, 'USER_NOT_FOUND');
    exit(1);
}
\$user->delete();
echo 'USER_DELETED';
"; then show_success "User ${user_id} deleted successfully."
    else show_error "User could not be deleted."; fi
    pause_short
}

# ==============================================================================
# SERVER INFORMATION
# ==============================================================================

server_information() {
    clear_screen
    local hostname_value os_name kernel cpu cores ram disk uptime_value ipv4 private_ipv4 ipv6 ip_type
    hostname_value="$(hostname 2>/dev/null || echo "Unknown")"
    os_name="$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-Unknown}")"
    kernel="$(uname -r 2>/dev/null || echo "Unknown")"
    cpu="$(lscpu 2>/dev/null | awk -F: '/Model name/ {gsub(/^[ \t]+/, "", $2); print $2; exit}')"
    [[ -z "$cpu" ]] && cpu="Unknown"
    cores="$(nproc 2>/dev/null || echo "Unknown")"
    ram="$(free -h 2>/dev/null | awk '/^Mem:/ {print $3 " / " $2}')"
    [[ -z "$ram" ]] && ram="Unknown"
    disk="$(df -h / 2>/dev/null | awk 'NR==2 {print $3 " / " $2 " (" $5 " used)"}')"
    [[ -z "$disk" ]] && disk="Unknown"
    uptime_value="$(uptime -p 2>/dev/null || echo "Unknown")"
    ipv4="$(curl -4 -fsSL --max-time 5 https://api.ipify.org 2>/dev/null || true)"
    [[ -z "$ipv4" ]] && ipv4="No IPv4 address"
    private_ipv4="$(ip -4 addr show scope global 2>/dev/null | awk '/inet / {split($2,a,"/"); if (a[1] !~ /^127\./) {print a[1]; exit}}')"
    [[ -z "$private_ipv4" ]] && private_ipv4="No private IPv4"
    ipv6="$(curl -6 -fsSL --max-time 5 https://api6.ipify.org 2>/dev/null || true)"
    [[ -z "$ipv6" ]] && ipv6="No IPv6 address"
    ip_type="Unknown"
    if [[ -n "$ipv4" && "$ipv4" != "No IPv4 address" ]]; then ip_type="Public IPv4 detected"; fi
    show_page_header "🖥  SERVER INFORMATION" "Hardware, operating system and network information"
    show_section "HOST"
    echo
    echo -e "  ${CYAN}│${RESET} Hostname       : ${WHITE}${hostname_value}${RESET}"
    echo -e "  ${CYAN}│${RESET} Operating Sys  : ${WHITE}${os_name}${RESET}"
    echo -e "  ${CYAN}│${RESET} Kernel         : ${WHITE}${kernel}${RESET}"
    echo -e "  ${CYAN}│${RESET} Uptime         : ${WHITE}${uptime_value}${RESET}"
    show_section "HARDWARE"
    echo
