install_vps_packages() {
    show_page_header "📦  VPS PACKAGE INSTALLER" "Install packages required by the VPS setup"
    echo

    if ! command_exists apt-get; then
        show_error "This installer requires a Debian/Ubuntu-based system."
        pause_short
        return 1
    fi

    if ! confirm_action "Install qemu-system, cloud-image-utils, wget and lsof?"; then
        pause_short
        return 1
    fi

    export DEBIAN_FRONTEND=noninteractive
    if ! apt-get update; then
        show_error "Package list update failed."
        pause_short
        return 1
    fi

    if apt-get install -y qemu-system cloud-image-utils wget lsof; then
        show_success "VPS packages installed successfully."
    else
        show_error "Some packages could not be installed."
    fi
    pause_short
}

run_vps_setup() {
    local name="$1"
    local url="$2"
    local temp_file result

    show_page_header "🖥  ${name}" "Download and run the selected VPS setup"
    echo

    if ! command_exists curl; then
        show_error "curl is required to download the setup script."
        pause_short
        return 1
    fi

    temp_file="$(mktemp /tmp/apex-vps-setup.XXXXXX)" || {
        show_error "Could not create a temporary file."
        pause_short
        return 1
    }

    echo -e "  ${CYAN}→${RESET} Downloading ${WHITE}${name}${RESET}..."
    if ! curl -fsSL --connect-timeout 10 --max-time 180 "$url" -o "$temp_file"; then
        rm -f "$temp_file"
        show_error "Download failed."
        pause_short
        return 1
    fi

    if [[ ! -s "$temp_file" ]]; then
        rm -f "$temp_file"
        show_error "The downloaded script is empty."
        pause_short
        return 1
    fi

    if ! bash -n "$temp_file"; then
        rm -f "$temp_file"
        show_error "The downloaded script has a Bash syntax error."
        pause_short
        return 1
    fi

    echo
    show_warning "This setup script will run with root privileges."
    echo -e "  ${GRAY}Review the downloaded script before approving execution:${RESET}"
    echo
    if command_exists less; then less "$temp_file"
    else cat "$temp_file"; fi

    if ! confirm_action "Run the downloaded ${name} setup script?"; then
        rm -f "$temp_file"
        pause_short
        return 1
    fi

    bash "$temp_file"
    result=$?
    rm -f "$temp_file"

    if (( result == 0 )); then
        show_success "${name} setup script finished."
    else
        show_error "${name} setup script exited with code ${result}."
    fi
    pause_short
    return "$result"
}

