install_cloudflared() {
    show_page_header "☁  INSTALL CLOUDFLARED" "Install Cloudflare Tunnel client"
    echo
    if command -v cloudflared >/dev/null 2>&1; then
        show_info "Cloudflared is already installed."
        echo
        cloudflared --version 2>/dev/null || true
        pause_short
        return
    fi
    if ! command_exists curl; then show_error "curl is required."; pause_short; return; fi
    local arch download_arch url="/usr/local/bin/cloudflared" tmp="/tmp/cloudflared-apex"
    arch="$(uname -m)"
    case "$arch" in
        x86_64|amd64) download_arch="amd64" ;;
        aarch64|arm64) download_arch="arm64" ;;
        armv7l|armv7) download_arch="arm" ;;
        *) show_error "Unsupported architecture: $arch"; pause_short; return ;;
    esac
    echo -e "  Architecture : ${WHITE}${arch}${RESET}"
    echo -e "  Target       : ${WHITE}${url}${RESET}"
    echo
    echo -e "  ${CYAN}→${RESET} Downloading Cloudflared..."
    if ! curl -fL --retry 2 --connect-timeout 10 --max-time 120 "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${download_arch}" -o "$tmp"; then
        rm -f "$tmp"; show_error "Cloudflared download failed."; pause_short; return
    fi
    if [[ ! -s "$tmp" ]]; then rm -f "$tmp"; show_error "Downloaded file is empty."; pause_short; return; fi
    chmod +x "$tmp"
    if ! mv "$tmp" "$url"; then rm -f "$tmp"; show_error "Could not install Cloudflared to /usr/local/bin."; pause_short; return; fi
    if ! "$url" --version >/dev/null 2>&1; then rm -f "$url"; show_error "Cloudflared installation verification failed."; pause_short; return; fi
    show_success "Cloudflared installed successfully."
    echo
    "$url" --version 2>/dev/null || true
    pause_short
}

install_tailscale() {
    show_page_header "🔗  INSTALL TAILSCALE" "Install Tailscale networking"
    echo
    if command_exists tailscale; then
        show_info "Tailscale is already installed."
        echo
        tailscale version 2>/dev/null || true
        pause_short
        return
    fi
    if ! command_exists curl; then show_error "curl is required."; pause_short; return; fi
    echo -e "  ${CYAN}→${RESET} Installing Tailscale..."
    echo
    if ! curl -fsSL https://tailscale.com/install.sh | sh; then show_error "Tailscale installation failed."; pause_short; return; fi
    if ! command_exists tailscale; then show_error "Tailscale installation could not be verified."; pause_short; return; fi
    if command_exists systemctl; then
        if ! systemctl enable --now tailscaled; then
            show_error "Tailscale installed, but tailscaled could not be started."
            echo
            echo -e "  ${GRAY}Try: systemctl status tailscaled${RESET}"
            pause_short
            return
        fi
    fi
    show_success "Tailscale installed successfully."
    echo
    echo -e "  ${WHITE}Next step:${RESET}"
    echo -e "  ${CYAN}tailscale up${RESET}"
    pause_short
}

uninstall_cloudflared() {
    show_page_header "🗑  UNINSTALL CLOUDFLARED" "Remove Cloudflare Tunnel client"
    echo
    if ! command -v cloudflared >/dev/null 2>&1 && [[ ! -f /usr/local/bin/cloudflared ]]; then
        show_info "Cloudflared is not installed."
        pause_short
        return
    fi
    if ! confirm_action "This will remove Cloudflared from this server."; then pause_short; return; fi
    if command_exists systemctl; then systemctl stop cloudflared 2>/dev/null || true; systemctl disable cloudflared 2>/dev/null || true; fi
    rm -f /usr/local/bin/cloudflared
    if [[ -e /usr/local/bin/cloudflared ]]; then show_error "Cloudflared could not be removed."
    else show_success "Cloudflared removed successfully."; fi
    pause_short
}

uninstall_tailscale() {
    show_page_header "🗑  UNINSTALL TAILSCALE" "Remove Tailscale networking"
    echo
    if ! command_exists tailscale; then show_info "Tailscale is not installed."; pause_short; return; fi
    if ! confirm_action "This will remove Tailscale from this server."; then pause_short; return; fi
    if command_exists systemctl; then systemctl disable --now tailscaled 2>/dev/null || true; fi
    local removed=0
    if command_exists apt-get; then
        export DEBIAN_FRONTEND=noninteractive
        if apt-get remove --purge -y tailscale; then removed=1; fi
        apt-get autoremove -y >/dev/null 2>&1 || true
    elif command_exists dnf; then
        if dnf remove -y tailscale; then removed=1; fi
    elif command_exists yum; then
        if yum remove -y tailscale; then removed=1; fi
    fi
    if (( removed == 1 )) && ! command_exists tailscale; then show_success "Tailscale removed successfully."
    elif ! command_exists tailscale; then show_success "Tailscale binary is no longer available."
    else show_error "Tailscale could not be fully removed."; fi
    pause_short
}

