clear_screen() {
    clear 2>/dev/null || printf '\033c'
}

pause() {
    echo
    read -r -p "  ${CYAN}➜${RESET} Press ENTER to continue..." _
}

pause_short() {
    echo
    read -r -p "  ${CYAN}➜${RESET} Press ENTER to return..." _
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

root_check() {
    if [[ $EUID -ne 0 ]]; then
        echo
        echo -e "  ${RED}${BOLD}╭────────────────────────────────────────────╮${RESET}"
        echo -e "  ${RED}${BOLD}│ ✗ APEX CLOULD must be run as root.       │${RESET}"
        echo -e "  ${RED}${BOLD}╰────────────────────────────────────────────╯${RESET}"
        echo
        exit 1
    fi
}

show_error() {
    echo
    echo -e "  ${RED}✗${RESET} ${RED}$1${RESET}"
}

show_success() {
    echo
    echo -e "  ${GREEN}✓${RESET} ${GREEN}$1${RESET}"
}

show_info() {
    echo
    echo -e "  ${CYAN}●${RESET} ${CYAN}$1${RESET}"
}

show_warning() {
    echo
    echo -e "  ${YELLOW}⚠${RESET} ${YELLOW}$1${RESET}"
}

confirm_action() {
    local message="$1"

    echo
    echo -e "  ${YELLOW}╭─ WARNING ───────────────────────────────────────────────────────────────╮${RESET}"
    echo -e "  ${YELLOW}│${RESET} ${YELLOW}${message}${RESET}"
    echo -e "  ${YELLOW}╰────────────────────────────────────────────────────────────────────────╯${RESET}"
    echo

    read -r -p "  ${YELLOW}Continue? [y/N]: ${RESET}" answer

    case "$answer" in
        y|Y|yes|YES) return 0 ;;
        *) echo -e "  ${GRAY}Cancelled.${RESET}"; return 1 ;;
    esac
}

