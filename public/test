    echo
    echo -e "  ${CYAN}│${RESET} Configuration    : ${WHITE}/etc/ssh/sshd_config${RESET}"
    echo -e "  ${CYAN}│${RESET} Root Login       : ${GREEN}ENABLE${RESET}"
    echo -e "  ${CYAN}│${RESET} Password Auth    : ${GREEN}ENABLE${RESET}"
    echo -e "  ${CYAN}│${RESET} Configuration    : ${GREEN}BACKUP${RESET}"
    echo -e "  ${CYAN}╰──────────────────────────────────────────────────────────────────────────────╯${RESET}"
    echo
    if ! [[ -f /etc/ssh/sshd_config ]]; then show_error "/etc/ssh/sshd_config was not found."; pause_short; return; fi
    if ! confirm_action "This will modify SSH configuration and restart SSH."; then pause_short; return; fi
    local CONFIG_FILE="/etc/ssh/sshd_config"
    echo
    echo -e "  ${CYAN}→${RESET} Creating SSH configuration backup..."
    if ! cp -a "$CONFIG_FILE" "${CONFIG_FILE}.bak"; then show_error "Could not create SSH configuration backup."; pause_short; return; fi
    echo -e "  ${GREEN}✓ Backup created${RESET}"
    sed -i 's/^#PermitRootLogin.*/PermitRootLogin yes/' "$CONFIG_FILE"
    grep -q "^PermitRootLogin" "$CONFIG_FILE" || echo "PermitRootLogin yes" >> "$CONFIG_FILE"
    echo -e "  ${GREEN}✓ PermitRootLogin enabled${RESET}"
    sed -i '/^#PasswordAuthentication/d' "$CONFIG_FILE"
    sed -i '/^PasswordAuthentication/d' "$CONFIG_FILE"
    echo "PasswordAuthentication yes" >> "$CONFIG_FILE"
    echo -e "  ${GREEN}✓ PasswordAuthentication enabled${RESET}"
    echo
    echo -e "  ${CYAN}[*]${RESET} Restarting SSH service..."
    if command_exists systemctl; then
        if systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null; then
            echo -e "  ${GREEN}✓ SSH service restarted${RESET}"
        else
            show_error "Could not restart SSH. Check the service and configuration."
        fi
    else
        show_warning "systemctl was not found; restart SSH manually."
    fi
    echo
    echo -e "  ${GREEN}╭────────────────────────────────────────────────────────────────────────╮${RESET}"
    echo -e "  ${GREEN}│${RESET} ${BOLD}${GREEN}✓ SSH configuration step completed${RESET}                              ${GREEN}│${RESET}"
    echo -e "  ${GREEN}├────────────────────────────────────────────────────────────────────────┤${RESET}"
    echo -e "  ${GREEN}│${RESET} ${YELLOW}Set the root password manually if needed:${RESET}                        ${GREEN}│${RESET}"
    echo -e "  ${GREEN}│${RESET} Run: ${CYAN}passwd root${RESET}                                                    ${GREEN}│${RESET}"
    echo -e "  ${GREEN}╰────────────────────────────────────────────────────────────────────────╯${RESET}"
    pause_short
}

